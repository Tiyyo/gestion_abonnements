{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abonnements.local/contracts/enrich.schema.json",
  "title": "POST /enrich",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "iconKey", "cancelUrl", "trialDays", "confidence"],
      "properties": {
        "category": {
          "enum": ["Musique", "Vidéo", "Stockage cloud", "Jeux", "Productivité", "Presse", "Santé/Sport", "IA", "Autre"]
        },
        "iconKey": {
          "description": "Slug Simple Icons ; l'appartenance à la liste embarquée est vérifiée dans le code.",
          "type": ["string", "null"],
          "pattern": "^[a-z0-9_]+$"
        },
        "cancelUrl": {
          "type": ["string", "null"],
          "format": "uri",
          "pattern": "^https://"
        },
        "trialDays": { "type": ["integer", "null"], "minimum": 0, "maximum": 365 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
